{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Run Jest on Current File",
      "request": "launch",
      "program": "${workspaceFolder}/../../node_modules/jest/bin/jest.js",
      "args": [
        "${fileBasenameNoExtension}",
        "--config",
        "jest.config.js",
        "--runInBand"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}